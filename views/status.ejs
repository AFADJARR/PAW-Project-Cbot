<%- include('partials/head') %>

<h1 class="text-xl font-semibold mb-4">Cek Status Pesanan</h1>

<form method="get" action="/status" class="<%= ui.card %> p-5 flex flex-col sm:flex-row gap-3">
  <label for="kode" class="sr-only">Kode pesanan</label>
  <input id="kode" name="kode" type="text" maxlength="20" required autocomplete="off" placeholder="Contoh: PLT-AB3K7M"
    value="<%= kode %>" class="<%= ui.input %> uppercase tracking-wider">
  <button type="submit" class="<%= ui.btn %> shrink-0">Cek Status</button>
</form>

<% if (notFound) { %>
  <p role="alert" class="mt-4 rounded-xl border border-red-200 bg-red-50 text-red-700 px-4 py-3 text-sm">Kode pesanan tidak ditemukan.</p>
<% } %>

<% if (pesanan) { %>
  <section class="<%= ui.card %> p-5 sm:p-6 mt-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs text-slate-500">Kode pesanan</p>
        <p class="text-lg font-semibold tracking-wider"><%= pesanan.kode %></p>
      </div>
      <span class="px-3 py-1 rounded-full text-xs font-semibold <%= ui.status[pesanan.status] %>"><%= pesanan.status %></span>
    </div>

    <ol class="mt-5 grid grid-cols-4 gap-2 text-center text-[11px] sm:text-xs">
      <% const idx = STATUS.indexOf(pesanan.status);
         STATUS.forEach(function (s, i) { %>
        <li>
          <div class="h-1.5 rounded-full <%= i <= idx ? 'bg-slate-900' : 'bg-slate-200' %>"></div>
          <p class="mt-1 <%= i === idx ? 'font-semibold text-slate-900' : 'text-slate-500' %>"><%= s %></p>
        </li>
      <% }) %>
    </ol>

    <dl class="mt-5 text-sm grid grid-cols-[110px_1fr] gap-y-1.5">
      <dt class="text-slate-500">Varian</dt><dd><%= pesanan.jenisKendaraan %> &middot; <%= pesanan.bahan %> &middot; <%= pesanan.varian %></dd>
      <dt class="text-slate-500">Teks plat</dt><dd class="font-semibold tracking-widest"><%= pesanan.teksPlat %></dd>
      <dt class="text-slate-500">Warna</dt><dd><%= pesanan.warna %></dd>
      <dt class="text-slate-500">Jumlah</dt><dd><%= pesanan.jumlah %></dd>
      <dt class="text-slate-500">Total</dt><dd class="font-semibold"><%= formatRupiah(pesanan.total) %></dd>
      <dt class="text-slate-500">Dipesan</dt><dd><%= formatTanggal(pesanan.createdAt) %></dd>
    </dl>

    <p class="mt-4 text-xs text-slate-500">Pembayaran dilakukan di luar aplikasi (transfer/QRIS atau bayar di tempat) dan dicek oleh pemilik toko.</p>
  </section>
<% } %>

<%- include('partials/footer') %>
