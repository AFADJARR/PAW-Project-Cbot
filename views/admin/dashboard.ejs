<%- include('../partials/adminHead') %>

<h1 class="text-xl font-semibold mb-4">Dashboard</h1>

<div class="grid grid-cols-2 lg:grid-cols-5 gap-3">
  <div class="<%= ui.card %> p-4 col-span-2 lg:col-span-1">
    <p class="text-xs text-slate-500">Total pesanan</p>
    <p class="text-2xl font-semibold mt-1"><%= rekap.jumlah %></p>
  </div>
  <% rekap.perStatus.forEach(function (s) { %>
    <a href="/admin/pesanan?status=<%= encodeURIComponent(s.status) %>" class="<%= ui.card %> p-4 hover:border-slate-900 transition">
      <p class="text-xs text-slate-500"><%= s.status %></p>
      <p class="text-2xl font-semibold mt-1"><%= s.jumlah %></p>
    </a>
  <% }) %>
</div>

<div class="grid gap-3 sm:grid-cols-2 mt-3">
  <div class="<%= ui.card %> p-4">
    <p class="text-xs text-slate-500">Nilai seluruh pesanan</p>
    <p class="text-xl font-semibold mt-1"><%= formatRupiah(rekap.nilai) %></p>
  </div>
  <a href="/admin/produk" class="<%= ui.card %> p-4 hover:border-slate-900 transition">
    <p class="text-xs text-slate-500">Produk tersedia</p>
    <p class="text-xl font-semibold mt-1"><%= produk.tersedia %> <span class="text-sm font-normal text-slate-500">dari <%= produk.total %> varian</span></p>
  </a>
</div>

<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mt-8 mb-3">Pesanan terbaru</h2>
<div class="<%= ui.card %> overflow-x-auto">
  <% if (!terbaru.length) { %>
    <p class="p-4 text-sm text-slate-500">Belum ada pesanan.</p>
  <% } else { %>
    <table class="w-full min-w-[560px]">
      <thead class="border-b border-slate-200"><tr>
        <th class="<%= ui.th %>">Kode</th><th class="<%= ui.th %>">Pelanggan</th><th class="<%= ui.th %>">Plat</th><th class="<%= ui.th %>">Total</th><th class="<%= ui.th %>">Status</th>
      </tr></thead>
      <tbody>
        <% terbaru.forEach(function (p) { %>
          <tr class="border-b border-slate-100 last:border-0">
            <td class="<%= ui.td %> font-medium whitespace-nowrap"><%= p.kode %></td>
            <td class="<%= ui.td %>"><%= p.nama %></td>
            <td class="<%= ui.td %> tracking-wider"><%= p.teksPlat %></td>
            <td class="<%= ui.td %> whitespace-nowrap"><%= formatRupiah(p.total) %></td>
            <td class="<%= ui.td %>"><span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= ui.status[p.status] %>"><%= p.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/adminFoot') %>
