<%- include('partials/head') %>

<section class="<%= ui.card %> p-5 sm:p-6">
  <div class="flex items-start gap-3">
    <div class="shrink-0 w-10 h-10 rounded-full bg-slate-900 text-white grid place-items-center text-sm font-semibold">CB</div>
    <div class="bg-slate-100 rounded-2xl rounded-tl-sm px-4 py-3">
      <p class="font-medium">Halo! Mau pesan plat untuk kendaraan apa?</p>
      <p class="text-sm text-slate-500 mt-1">Pilih jenis kendaraan untuk melihat varian dan harga, atau langsung pesan.</p>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 mt-5 sm:ml-[52px]">
    <a href="/?jenis=Mobil"
       class="px-5 py-2 rounded-full border text-sm font-medium transition <%= jenis === 'Mobil' ? 'bg-slate-900 text-white border-slate-900' : 'bg-white border-slate-300 hover:border-slate-900' %>">Mobil</a>
    <a href="/?jenis=Motor"
       class="px-5 py-2 rounded-full border text-sm font-medium transition <%= jenis === 'Motor' ? 'bg-slate-900 text-white border-slate-900' : 'bg-white border-slate-300 hover:border-slate-900' %>">Motor</a>
    <a href="/pesan" class="px-5 py-2 rounded-full border border-emerald-600 text-emerald-700 text-sm font-medium hover:bg-emerald-50 transition">Pesan Plat</a>
    <a href="/status" class="px-5 py-2 rounded-full border border-slate-300 text-sm font-medium hover:border-slate-900 transition">Cek Status</a>
  </div>
</section>

<% if (jenis) { %>
  <section class="mt-6">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3">Varian plat <%= jenis %> yang tersedia</h2>

    <% if (produk.length === 0) { %>
      <p class="<%= ui.card %> p-4 text-sm text-slate-500">Maaf, belum ada varian yang tersedia untuk <%= jenis %>.</p>
    <% } else { %>
      <ul class="grid gap-3 sm:grid-cols-2">
        <% produk.forEach(function (p) { %>
          <li class="<%= ui.card %> p-4 flex items-center justify-between gap-3">
            <div>
              <p class="font-medium"><%= p.bahan %> &middot; <%= p.varian %></p>
              <p class="text-xs text-slate-500 mt-0.5"><%= p.jenisKendaraan %></p>
            </div>
            <p class="font-semibold whitespace-nowrap"><%= formatRupiah(p.harga) %></p>
          </li>
        <% }) %>
      </ul>
      <a href="/pesan" class="<%= ui.btn %> mt-4">Pesan sekarang</a>
    <% } %>

    <a href="/" class="inline-block mt-4 ml-2 text-sm text-slate-600 underline">&larr; Kembali ke menu utama</a>
  </section>
<% } %>

<%- include('partials/chat') %>

<%- include('partials/footer') %>
