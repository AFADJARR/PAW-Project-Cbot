<section id="chat" class="mt-8 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
  <div class="px-4 py-3 border-b border-slate-200 flex items-center gap-3">
    <div class="w-8 h-8 rounded-full bg-slate-900 text-white grid place-items-center text-xs font-semibold">AI</div>
    <div>
      <h2 class="text-sm font-semibold leading-tight">Asisten Cbot Plat</h2>
      <p class="text-xs text-slate-500">Tanya produk, harga, dan ketersediaan plat</p>
    </div>
  </div>

  <div id="chat-messages" class="h-[55vh] sm:h-96 overflow-y-auto p-4 space-y-3 bg-slate-50" aria-live="polite">
    <div class="flex justify-start">
      <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-white border border-slate-200 px-3 py-2 text-sm whitespace-pre-wrap break-words">Halo! Saya Asisten Cbot Plat. Saya bisa membantu informasi produk plat nomor: jenis kendaraan, bahan, varian, harga, dan ketersediaan. Ada yang ingin ditanyakan?</div>
    </div>
  </div>

  <div class="px-4 pt-3 flex flex-wrap gap-2" id="chat-suggestions">
    <button type="button" data-pertanyaan="Apa saja produk yang tersedia?" class="text-xs px-3 py-1.5 rounded-full border border-slate-300 hover:border-slate-900 transition">Produk yang tersedia</button>
    <button type="button" data-pertanyaan="Berapa harga plat untuk motor?" class="text-xs px-3 py-1.5 rounded-full border border-slate-300 hover:border-slate-900 transition">Harga plat motor</button>
    <button type="button" data-pertanyaan="Bahan apa saja untuk plat mobil?" class="text-xs px-3 py-1.5 rounded-full border border-slate-300 hover:border-slate-900 transition">Bahan plat mobil</button>
  </div>

  <form id="chat-form" class="p-4 flex items-start gap-2" data-max="<%= maxPesan %>" autocomplete="off">
    <div class="flex-1">
      <label for="chat-input" class="sr-only">Pertanyaan Anda</label>
      <textarea id="chat-input" rows="1" maxlength="<%= maxPesan %>" placeholder="Tulis pertanyaan Anda..."
        class="w-full resize-none rounded-xl border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"></textarea>
      <p class="text-[11px] text-slate-400 mt-1 text-right"><span id="chat-counter">0</span>/<%= maxPesan %></p>
    </div>
    <button id="chat-send" type="submit"
      class="shrink-0 h-10 px-4 rounded-xl bg-slate-900 text-white text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed">Kirim</button>
  </form>
</section>

<script src="/js/chat.js" defer></script>
